{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run",
    "build": "node scripts/build-client.ts",
    "migrate": "node src/server/migrate.ts",
    "start": "node src/server/index.ts",
    "dev": "pnpm migrate && pnpm build && pnpm start"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "0.182.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "three": "^0.182.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
